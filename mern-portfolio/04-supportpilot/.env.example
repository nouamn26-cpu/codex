# Copy to .env. Local file storage works without a database account.
PORT=4104
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
# Demo seeding defaults to true locally and false in production.
SEED_DEMO=true
DATA_DIR=.data
# Optional PAID external AI. Leave both blank for free local knowledge search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
