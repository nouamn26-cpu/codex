# Copy to .env. No database is required for the local file-backed demo.
PORT=4105
MONGODB_URI=
# Set a unique random secret, at least 32 characters. Mandatory in production.
JWT_SECRET=
# Public demo accounts are created when explicitly true. Defaults true outside production.
SEED_DEMO=true
# Set NODE_ENV=production only for hosting. MongoDB is mandatory then.
NODE_ENV=development
