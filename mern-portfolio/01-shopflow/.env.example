# Node 22.12+ or 24 LTS. Copy this file to .env in VS Code.
PORT=4101
# Local demo works without MongoDB. Omit MONGODB_URI to use .data/shopflow.json.
# Mongo uses transactions: Atlas Free or a local replica set is required.
MONGODB_URI=
# Required in production; replace with a random value of at least 32 characters.
JWT_SECRET=
# Explicitly true to seed the public sample accounts/catalogue in production.
# Development seeds demo data unless SEED_DEMO=false.
SEED_DEMO=true
# NODE_ENV=production
