# Optional for local use. Without a MongoDB URI, data persists in .data/bookease.json.
PORT=4102
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-publishing
SEED_DEMO=true
MONGODB_URI=
# All booking times are interpreted in Asia/Karachi, with 10:00–19:00 opening hours.
# Leave SMTP empty to keep notifications in the clearly labelled demo outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BookEase <bookings@example.com>

# For a NEW non-demo database only: set SEED_DEMO=false and bootstrap an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
