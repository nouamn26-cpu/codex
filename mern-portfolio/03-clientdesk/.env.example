# Local: npm install, copy this file to .env, npm run dev.
PORT=4103
NODE_ENV=development
# Leave empty for persistent local JSON demo. Set a MongoDB Atlas URI for MERN mode.
MONGODB_URI=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Development defaults to true; production defaults to false. Never use demo passwords for private data.
SEED_DEMO=true
# Optional absolute or relative JSON path, defaults to .data/clientdesk.json
DATA_FILE=
